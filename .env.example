# Public hostname that points at your home IP (e.g. a DuckDNS / Cloudflare DNS name)
DOMAIN=cruise.example.com

# First admin account (only used the very first time the server starts)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# Optional: Textbelt key to start with. You can also pick Textbelt/Twilio/webhook later in Settings (admin).
TEXTBELT_KEY=

# How often to check everyone's price alerts
CHECK_INTERVAL_HOURS=6
